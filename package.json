{
  "name": "homebridge-people-ultra",
  "displayName": "People Ultra",
  "type": "module",
  "version": "0.1.2",
  "description": "Homebridge plugin that creates presence sensors for people on your network.",
  "author": "Lester Chan",
  "license": "MIT",
  "homepage": "https://github.com/lesterchan/homebridge-people-ultra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lesterchan/homebridge-people-ultra.git"
  },
  "bugs": {
    "url": "https://github.com/lesterchan/homebridge-people-ultra/issues"
  },
  "keywords": [
    "homebridge-plugin"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json"
  ],
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "watch": "npm run build && npm link && nodemon",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage \"test/**/*.test.ts\""
  },
  "dependencies": {
    "fakegato-history": "^0.6.7",
    "local-devices": "^4.0.0",
    "node-arp": "^1.0.6",
    "ping": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "homebridge": "^2.0.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
